    <!-- Maintenance Mode (only shown when plugin is active) -->
    {% if maintenancePluginActive %}
    <div class="card">
      <div class="p-6">
        <h3 class="text-lg font-medium text-gray-900 mb-4 flex items-center">
          <i class="fas fa-tools mr-3 text-gray-600"></i>
