            <label class="flex items-start">
              <input type="checkbox" name="maintenance_show_countdown" class="rounded border-gray-300 text-black focus:ring-black mt-1" {{ (settings['maintenance.show_countdown'] ?? true) ? 'checked' : '' }}>
              <span class="ml-3">
                <span class="text-sm font-medium text-gray-900 block">{{ trans('admin.maintenance.show_animation') }}</span>
