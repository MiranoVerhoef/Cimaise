    {# Build sanitized settings for plugin hooks - exclude sensitive keys #}
    {% set sensitive_keys = ['recaptcha.secret_key', 'recaptcha.site_key', 'api.key', 'api.secret', 'smtp.password', 'mail.password'] %}
    {% set public_settings = {} %}
    {% for key, value in settings %}
      {% if key not in sensitive_keys and not (key starts with 'secret') and not (key ends with '_secret') and not (key ends with '_key') %}
        {% set public_settings = public_settings|merge({(key): value}) %}
      {% endif %}
    {% endfor %}

    {# Hook for plugins to add content inside the settings form #}
    {{ hook('admin_settings_form_end', {'base_path': base_path, 'settings': public_settings, 'csp_nonce': csp_nonce()}) }}

    {% endif %}
    </form>

    {# Hook for plugins to add standalone sections outside the form #}
    {{ hook('admin_settings_after_form', {'base_path': base_path, 'settings': public_settings, 'csp_nonce': csp_nonce()}) }}

  </div>

  <!-- Sticky Footer with Action Buttons -->
  <div class="fixed bottom-0 left-0 lg:left-64 right-0 bg-white border-t border-gray-200 shadow-lg admin-sticky-actions">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 sm:py-4">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div class="flex flex-wrap items-center gap-2 sm:gap-3">
          <button type="submit" form="settings-form" class="btn-primary text-sm sm:text-base">
            <i class="fas fa-save mr-2"></i>
            {{ trans('admin.common.save') }}
          </button>
          <a href="{{ base_path }}/admin" class="btn-secondary text-sm sm:text-base">
            <i class="fas fa-arrow-left mr-2"></i>
            {{ trans('admin.common.dashboard') }}
